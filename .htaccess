# Domínio canônico: https://www.campechelofts.floripa.br
# Hosts antigos, sem www e http redirecionam (301) para ele.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Não redirecionar validações de certificado (AutoSSL/Let's Encrypt)
  RewriteRule ^\.well-known/ - [L]

  # 1) Hosts antigos -> novo domínio
  RewriteCond %{HTTP_HOST} ^(www\.)?(pousada|campechelofts)\.aetsolidez\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.campechelofts.floripa.br/$1 [R=301,L]

  # 2) Sem www -> com www
  RewriteCond %{HTTP_HOST} ^campechelofts\.floripa\.br$ [NC]
  RewriteRule ^(.*)$ https://www.campechelofts.floripa.br/$1 [R=301,L]

  # 3) http -> https no domínio novo
  RewriteCond %{HTTP_HOST} ^www\.campechelofts\.floripa\.br$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://www.campechelofts.floripa.br/$1 [R=301,L]

  # Rede de segurança: qualquer outro host em http vai para https
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Headers de segurança — baixo risco, não deveriam quebrar nada do site
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Impede listagem de arquivos em pastas sem index (ex. /images/)
Options -Indexes

# Página 404 personalizada
ErrorDocument 404 /404.html

# Cache HTTP — imagens raramente mudam, cache longo é seguro
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # CSS/JS ainda não têm nome versionado — cache mais curto para que
  # atualizações futuras cheguem aos visitantes em tempo razoável
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  # HTML nunca em cache — sempre buscar a versão mais recente
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
